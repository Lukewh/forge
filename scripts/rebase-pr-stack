#!/usr/bin/env node
"use strict";

const fs = require("fs");
const os = require("os");
const path = require("path");
const { makeRebasePlan, runRebasePlan } = require("../lib/deterministic-agents.js");

function arg(name) {
  const i = process.argv.indexOf(name);
  return i === -1 ? null : process.argv[i + 1];
}

const issueId = Number(arg("--issue-id"));
if (!issueId) {
  console.error("Usage: scripts/rebase-pr-stack --issue-id <id>");
  process.exit(2);
}

const FORGE_DIR = process.env.FORGE_DIR || path.join(os.homedir(), ".pi", "agent", "extensions", "forge");
const Database = require(path.join(FORGE_DIR, "node_modules", "better-sqlite3"));
const db = new Database(path.join(FORGE_DIR, "forge.db"));

function setting(key, fallback = "") {
  return db.prepare("SELECT value FROM settings WHERE key = ?").get(key)?.value || fallback;
}

function baseBranch(issue) {
  try {
    const content = fs.readFileSync(issue.project_file_path, "utf-8");
    return content.match(/^base-branch:\s*(.+)$/m)?.[1]?.trim() || setting("default_branch", "main");
  } catch {
    return setting("default_branch", "main");
  }
}

try {
  const issue = db.prepare("SELECT * FROM issues WHERE id = ?").get(issueId);
  if (!issue) throw new Error(`Issue not found: ${issueId}`);
  const prStack = db.prepare("SELECT * FROM pr_stack WHERE issue_id = ? ORDER BY position ASC").all(issueId);
  const plan = makeRebasePlan({ baseBranch: baseBranch(issue), prStack });
  runRebasePlan({ cwd: issue.wt_path, plan, log: msg => console.log(`[forge:rebase] ${msg}`) });
  db.prepare("INSERT INTO activity_log (issue_id, type, actor, message, metadata) VALUES (?, 'deterministic_rebase', 'rebase-pr-stack', ?, ?)")
    .run(issueId, `Rebased ${plan.branches.length} branch(es) deterministically`, JSON.stringify(plan));
  db.close();
} catch (error) {
  console.error(`[forge:rebase] ${error.message}`);
  db.close();
  process.exit(1);
}
