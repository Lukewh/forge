#!/usr/bin/env node
"use strict";

const fs = require("fs");
const path = require("path");

function arg(name) {
  const i = process.argv.indexOf(name);
  return i === -1 ? null : process.argv[i + 1];
}

const agentsDir = path.resolve(arg("--agents-dir") || path.join(__dirname, "..", "agents"));
const patterns = [
  /ssh orb/i,
  /devcontainer/i,
  /dev container/i,
  /VM unavailable/i,
  /OrbStack unavailable/i,
  /node_modules (?:are )?missing|missing node_modules|lacks node_modules/i,
];

const matches = [];
for (const file of fs.readdirSync(agentsDir).filter(name => name.endsWith(".md")).sort()) {
  const full = path.join(agentsDir, file);
  const lines = fs.readFileSync(full, "utf-8").split("\n");
  const learnedStart = lines.findIndex(line => /^## Learned rules\s*$/.test(line));
  if (learnedStart === -1) continue;
  for (let i = learnedStart + 1; i < lines.length; i += 1) {
    const line = lines[i];
    if (/^##\s+/.test(line)) break;
    const pattern = patterns.find(candidate => candidate.test(line));
    if (pattern) matches.push({ file, lineNumber: i + 1, line, pattern: String(pattern) });
  }
}

console.log(JSON.stringify({ agentsDir, matches }, null, 2));
process.exit(0);
