#!/usr/bin/env node
"use strict";

const { execFileSync } = require("child_process");
const fs = require("fs");
const path = require("path");

function usage() {
  console.error("Usage: scripts/sync-worktree-to-base <worktree-path> [base-branch] [--allow-diverged-current]");
  process.exit(2);
}

const args = process.argv.slice(2);
const allowDivergedCurrent = args.includes("--allow-diverged-current") || process.env.FORGE_SYNC_ALLOW_DIVERGED_CURRENT === "1";
const positionalArgs = args.filter(arg => !arg.startsWith("--"));
const worktreePath = positionalArgs[0];
const baseBranch = positionalArgs[1] || "main";
if (!worktreePath) usage();

const cwd = path.resolve(worktreePath);
if (!fs.existsSync(cwd)) {
  console.log(`[forge:sync-base] Worktree does not exist, skipping: ${cwd}`);
  process.exit(0);
}

function git(args, options = {}) {
  return execFileSync("git", args, {
    cwd,
    encoding: "utf-8",
    timeout: options.timeout ?? 60000,
    stdio: options.stdio ?? ["ignore", "pipe", "pipe"],
  });
}

function isClean() {
  return git(["status", "--porcelain"])
    .split("\n")
    .filter(line => line.trim() && !/^\?\? (.+\/)?node_modules\/?$/.test(line))
    .join("\n") === "";
}

function remoteOnlyCommitsArePatchEquivalent(remoteRef) {
  const output = git(["cherry", "HEAD", remoteRef]).trim();
  if (!output) return true;
  return output.split("\n").every(line => line.startsWith("- "));
}

try {
  git(["rev-parse", "--is-inside-work-tree"]);
} catch (error) {
  console.log(`[forge:sync-base] Not a git worktree, skipping: ${cwd}`);
  process.exit(0);
}

if (!isClean()) {
  console.error("[forge:sync-base] Worktree has uncommitted changes; refusing to sync base.");
  process.exit(2);
}

const remoteRef = `refs/remotes/origin/${baseBranch}`;
try {
  console.log(`[forge:sync-base] Fetching origin/${baseBranch}…`);
  git(["fetch", "--prune", "origin", `+refs/heads/${baseBranch}:${remoteRef}`], { timeout: 120000, stdio: "inherit" });
} catch (error) {
  console.error(`[forge:sync-base] git fetch failed: ${error.message}`);
  process.exit(2);
}

try {
  git(["rev-parse", "--verify", remoteRef]);
} catch {
  console.error(`[forge:sync-base] Remote ref not found: ${remoteRef}`);
  process.exit(2);
}

let currentBranch = "";
try {
  currentBranch = git(["branch", "--show-current"]).trim();
} catch {}

if (currentBranch) {
  const currentRemoteRef = `refs/remotes/origin/${currentBranch}`;
  try {
    console.log(`[forge:sync-base] Fetching origin/${currentBranch}…`);
    git(["fetch", "--prune", "origin", `+refs/heads/${currentBranch}:${currentRemoteRef}`], { timeout: 120000, stdio: "inherit" });

    try {
      execFileSync("git", ["merge-base", "--is-ancestor", "HEAD", currentRemoteRef], { cwd, stdio: "ignore" });
      console.log(`[forge:sync-base] Fast-forwarding ${currentBranch} from origin/${currentBranch}…`);
      git(["merge", "--ff-only", currentRemoteRef], { timeout: 120000, stdio: "inherit" });
    } catch {
      try {
        execFileSync("git", ["merge-base", "--is-ancestor", currentRemoteRef, "HEAD"], { cwd, stdio: "ignore" });
        console.log(`[forge:sync-base] ${currentBranch} already contains origin/${currentBranch}.`);
      } catch {
        if (allowDivergedCurrent && remoteOnlyCommitsArePatchEquivalent(currentRemoteRef)) {
          console.log(`[forge:sync-base] ${currentBranch} and origin/${currentBranch} have diverged, but remote-only commits are patch-equivalent to local history; continuing before force-with-lease push.`);
        } else {
          console.error(`[forge:sync-base] ${currentBranch} and origin/${currentBranch} have diverged; refusing to pull before rebase.`);
          process.exit(2);
        }
      }
    }
  } catch (error) {
    console.log(`[forge:sync-base] No remote branch origin/${currentBranch} to pull, or fetch failed: ${error.message}`);
  }
}

try {
  execFileSync("git", ["merge-base", "--is-ancestor", remoteRef, "HEAD"], { cwd, stdio: "ignore" });
  console.log(`[forge:sync-base] Already contains origin/${baseBranch}.`);
  process.exit(0);
} catch {
  // origin/base is not an ancestor; rebase below.
}

try {
  console.log(`[forge:sync-base] Rebasing current branch onto origin/${baseBranch}…`);
  git(["rebase", remoteRef], { timeout: 120000, stdio: "inherit" });
  console.log(`[forge:sync-base] Rebasing onto origin/${baseBranch} complete.`);
  process.exit(0);
} catch (error) {
  try { git(["rebase", "--abort"], { timeout: 30000, stdio: "ignore" }); } catch {}
  console.error(`[forge:sync-base] Rebase failed; aborted. ${error.message}`);
  process.exit(2);
}
